# Traefik
TRAEFIK_HTTP_WEB_UI_PORT=8080
TRAEFIK_HTTP_WEB_PORT=80

# All versions
AWS_JAVA_SDK_VERSION=1.12.367
HADOOP_VERSION=3.3.6
HIVE_VERSION=3.1.3
ICEBERG_VERSION=1.4.3
KYUUBI_VERSION=1.9.1
KYUUBI_HADOOP_VERSION=3.3.6
POSTGRES_VERSION=12
POSTGRES_JDBC_VERSION=42.3.4
SCALA_BINARY_VERSION=2.12
SPARK_BINARY_VERSION=3.4
SPARK_HADOOP_VERSION=3.3.4
ZOOKEEPER_VERSION=3.6.3
PROMETHEUS_VERSION=2.45.2
GRAFANA_VERSION=10.0.10

# Apache Spark
SPARK_IMAGE=jsminet/docker-apache-spark
SPARK_VERSION=3.5.1
SPARK_GIT_URL=https://github.com/jsminet/docker-apache-spark.git
SPARK_HOME=/opt/spark
SPARK_MASTER_HOST=spark-master
SPARK_MASTER_PORT=7077
SPARK_CONF_DIR=/opt/spark/conf
SPARK_LOG_DIR=/opt/spark/logs
SPARK_WORKER_DIR=/opt/spark/work
SPARK_MASTER_WEBUI_PORT=8080
SPARK_UI_PORT=4040
SPARK_WORKER_WEBUI_PORT=8081
SPARK_WORKER_CORES=2
# Set the maximum memory by workers 
SPARK_WORKER_MEMORY=6g
SPARK_DRIVER_MEMORY=2g

HADOOP_IMAGE=jsminet/docker-apache-hadoop:3.3.6
HADOOP_GIT_URL=https://github.com/jsminet/docker-apache-hadoop.git#3.3.6
HADOOP_MAJOR_VERSION=3.3
HADOOP_MINOR_VERSION=3.3.6
HADOOP_HOME=/opt/hadoop-3.3.6
HADOOP_CONF_DIR=/opt/hadoop-3.3.6/etc/hadoop

HIVE_SERVER2_THRIFT_PORT=10000

ZEPPELIN_IMAGE=jsminet/docker-apache-zeppelin
ZEPPELIN_VERSION=0.11.0
ZEPPELIN_GIT_URL=https://github.com/jsminet/docker-apache-zeppelin.git#main:binary
ZEPPELIN_CONF_DIR=/app/zeppelin/conf
ZEPPELIN_LOG_DIR=/app/zeppelin/logs
ZEPPELIN_NOTEBOOK_DIR=/app/zeppelin/notebook
ZEPPELIN_HTTP_PORT=8080

MARIADB_IMAGE=mariadb:10.11.7
MARIADB_RPC_PORT=3306
MYSQL_ROOT_PASSWORD=secret

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=metastore
POSTGRES_RPC_PORT=5432

KYUUBI_GIT_URL=https://github.com/jsminet/docker-apache-kyuubi.git#1.9.1
KYUUBI_IMAGE=jsminet/docker-apache-kyuubi
KYUUBI_VERSION=1.9.1
KYUUBI_HOME=/opt/kyuubi
KYUUBI_FRONTEND_BIND_PORT=10009
KYUUBI_FRONTEND_REST_PORT=10099
KYUUBI_CONF_DIR=/opt/kyuubi/conf
KYUUBI_PID_DIR=/opt/kyuubi/pid
KYUUBI_LOG_DIR=/opt/kyuubi/logs
KYUUBI_WORK_DIR_ROOT=/opt/kyuubi/work

# Zookeeper
ZOOKEEPER_CONF_DIR=/conf

# Metastore
METASTORE_RPC_PORT=9083

# SwarmPit 
SWARMPIT_HTTP_PORT=8080
COUCHDB_USER=admin
COUCHDB_PASSWORD=COUCHDB_PASSWORD
COUCHDB_HTTP_PORT=5984
INFLUXDB_HTTP_PORT=8086

# Minio
MINIO_IMAGE=minio/minio
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_minio
MINIO_API_PORT_NUMBER=9000
MINIO_CONSOLE_PORT_NUMBER=9001

# Traefik DNS
#DATANODE1_DNS=datanode1
#DATANODE2_DNS=datanode2
#DATANODE3_DNS=datanode3
KYUUBI_SPARKUI_DNS=kyuubi_ui
KYUUBI_REST_DNS=kyuubi_rest
NAMENODE_DNS=namenode
NODEMANAGER_DNS=nodemanager
RESOURCEMANAGER_DNS=resourcemanager
SPARK_MASTER_DNS=sparkmaster
SPARK_WORKER_DNS=sparkworker
ZEPPELIN_DNS=zeppelin
ZEPPELIN_SPARKUI_DNS=zeppelin_ui
SWARMPIT_DNS=swarmpit
COUCHDB_DNS=couchdb
INFLUXDB_DNS=influxdb
MINIO_DNS=minio
MINIO_S3_ENDPOINT_DNS=minios3