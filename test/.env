# Apache Spark
SPARK_IMAGE=jsminet/docker-apache-spark
SPARK_VERSION=3.5.1
SPARK_GIT_URL=https://github.com/jsminet/docker-apache-spark.git
SPARK_HOME=/opt/spark
SPARK_MASTER_HOST=sparkmaster
SPARK_MASTER_PORT=7077
SPARK_CONF_DIR=/app/spark/conf
SPARK_LOG_DIR=/app/spark/logs
SPARK_WORKER_DIR=/app/spark/work
SPARK_MASTER_WEBUI_PORT=8080
SPARK_UI_PORT=4040
SPARK_WORKER_WEBUI_PORT=8081
SPARK_WORKER_CORES=2
# Set the maximum memory by workers 
SPARK_WORKER_MEMORY=6g
SPARK_DRIVER_MEMORY=2g

KYUUBI_GIT_URL=https://github.com/jsminet/docker-apache-kyuubi.git#1.9.1
KYUUBI_IMAGE=jsminet/docker-apache-kyuubi
KYUUBI_VERSION=1.9.1
KYUUBI_HOME=/opt/kyuubi
KYUUBI_FRONTEND_BIND_PORT=10009
KYUUBI_FRONTEND_REST_PORT=10099
KYUUBI_CONF_DIR=/app/kyuubi/conf
KYUUBI_PID_DIR=/app/kyuubi/pid
KYUUBI_LOG_DIR=/app/kyuubi/logs
KYUUBI_WORK_DIR_ROOT=/app/kyuubi/work
KYUUBI_JAR_DIR=/app/kyuubi/jars/*:/opt/kyuubi/jars

# Zookeeper
ZOOKEEPER_CONF_DIR=/conf

ZEPPELIN_IMAGE=jsminet/docker-apache-zeppelin
ZEPPELIN_VERSION=0.11.0
ZEPPELIN_CONF_DIR=/app/zeppelin/conf
ZEPPELIN_LOG_DIR=/app/zeppelin/logs
ZEPPELIN_NOTEBOOK_DIR=/app/zeppelin/notebook