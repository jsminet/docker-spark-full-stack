@echo on

set MAVEN_MIRROR=https://repo1.maven.org/maven2
set KYUUBI_VERSION=1.9.1
set SPARK_VERSION=3.5.1
set HADOOP_MAJOR_VERSION=3
set AWS_JAVA_SDK_VERSION=1.12.757
set SPARK_HADOOP_VERSION=3.3.4
set KYUUBI_HADOOP_VERSION=3.3.6
set HIVE_VERSION=3.1.3
set ICEBERG_VERSION=1.5.2
set POSTGRES_VERSION=12
set POSTGRES_JDBC_VERSION=42.7.3
set SCALA_BINARY_VERSION=2.12
set SPARK_BINARY_VERSION=3.5

set ICEBERG_SPARK_JAR_NAME=iceberg-spark-runtime-%SPARK_BINARY_VERSION%_%SCALA_BINARY_VERSION%
set SPARK_HADOOP_CLOUD_JAR_NAME=spark-hadoop-cloud_%SCALA_BINARY_VERSION%
set HADOOP_CLOUD_STORAGE_JAR_NAME=hadoop-cloud-storage
set HADOOP_AWS_JAR_NAME=hadoop-aws
set AWS_JAVA_SDK_BUNDLE_JAR_NAME=aws-java-sdk-bundle
set POSTGRES_JDBC_JAR_NAME=postgresql
set TPCDS_CONNECTOR_JAR_NAME=kyuubi-spark-connector-tpcds_%SCALA_BINARY_VERSION%
set TPCH_CONNECTOR_JAR_NAME=kyuubi-spark-connector-tpch_%SCALA_BINARY_VERSION%
set KYUUBI_HOME=/opt/apache-kyuubi-%KYUUBI_VERSION%-bin

curl %MAVEN_MIRROR%/org/apache/iceberg/%ICEBERG_SPARK_JAR_NAME%/%ICEBERG_VERSION%/%ICEBERG_SPARK_JAR_NAME%-%ICEBERG_VERSION%.jar ^
-o ./spark/%ICEBERG_SPARK_JAR_NAME%-%ICEBERG_VERSION%.jar

curl %MAVEN_MIRROR%/org/apache/spark/%SPARK_HADOOP_CLOUD_JAR_NAME%/%SPARK_VERSION%/%SPARK_HADOOP_CLOUD_JAR_NAME%-%SPARK_VERSION%.jar ^
-o ./spark/%SPARK_HADOOP_CLOUD_JAR_NAME%-%SPARK_VERSION%.jar

curl %MAVEN_MIRROR%/org/apache/hadoop/%HADOOP_CLOUD_STORAGE_JAR_NAME%/%SPARK_HADOOP_VERSION%/%HADOOP_CLOUD_STORAGE_JAR_NAME%-%SPARK_HADOOP_VERSION%.jar ^
-o ./spark/%HADOOP_CLOUD_STORAGE_JAR_NAME%-%SPARK_HADOOP_VERSION%.jar

curl %MAVEN_MIRROR%/org/apache/hadoop/%HADOOP_CLOUD_STORAGE_JAR_NAME%/%KYUUBI_HADOOP_VERSION%/%HADOOP_CLOUD_STORAGE_JAR_NAME%-%KYUUBI_HADOOP_VERSION%.jar ^
-o ./kyuubi/%HADOOP_CLOUD_STORAGE_JAR_NAME%-%KYUUBI_HADOOP_VERSION%.jar

curl %MAVEN_MIRROR%/org/apache/hadoop/%HADOOP_AWS_JAR_NAME%/%SPARK_HADOOP_VERSION%/%HADOOP_AWS_JAR_NAME%-%SPARK_HADOOP_VERSION%.jar ^
-o ./spark/%HADOOP_AWS_JAR_NAME%-%SPARK_HADOOP_VERSION%.jar

curl %MAVEN_MIRROR%/org/apache/hadoop/%HADOOP_AWS_JAR_NAME%/%KYUUBI_HADOOP_VERSION%/%HADOOP_AWS_JAR_NAME%-%KYUUBI_HADOOP_VERSION%.jar ^
-o ./kyuubi/%HADOOP_AWS_JAR_NAME%-%KYUUBI_HADOOP_VERSION%.jar

curl %MAVEN_MIRROR%/com/amazonaws/%AWS_JAVA_SDK_BUNDLE_JAR_NAME%/%AWS_JAVA_SDK_VERSION%/%AWS_JAVA_SDK_BUNDLE_JAR_NAME%-%AWS_JAVA_SDK_VERSION%.jar ^
-o ./common/%AWS_JAVA_SDK_BUNDLE_JAR_NAME%-%AWS_JAVA_SDK_VERSION%.jar

curl %MAVEN_MIRROR%/org/postgresql/%POSTGRES_JDBC_JAR_NAME%/%POSTGRES_JDBC_VERSION%/%POSTGRES_JDBC_JAR_NAME%-%POSTGRES_JDBC_VERSION%.jar ^
-o ./spark/%POSTGRES_JDBC_JAR_NAME%-%POSTGRES_JDBC_VERSION%.jar

curl %MAVEN_MIRROR%/org/apache/kyuubi/%TPCDS_CONNECTOR_JAR_NAME%/%KYUUBI_VERSION%/%TPCDS_CONNECTOR_JAR_NAME%-%KYUUBI_VERSION%.jar ^
-o ./spark/%TPCDS_CONNECTOR_JAR_NAME%-%KYUUBI_VERSION%.jar

curl %MAVEN_MIRROR%/org/apache/kyuubi/%TPCH_CONNECTOR_JAR_NAME%/%KYUUBI_VERSION%/%TPCH_CONNECTOR_JAR_NAME%-%KYUUBI_VERSION%.jar ^
-o ./spark/%TPCH_CONNECTOR_JAR_NAME%-%KYUUBI_VERSION%.jar